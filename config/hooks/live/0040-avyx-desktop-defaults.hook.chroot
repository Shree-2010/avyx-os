#!/bin/sh
# Make the AVYX wallpaper the default no matter which Plasma mechanism picks one, and
# drop leftover upstream branding that users could see.
set -e

if [ -d /usr/share/wallpapers/AVYX-Aurora ]; then
  rm -rf /usr/share/wallpapers/Next
  cp -a /usr/share/wallpapers/AVYX-Aurora /usr/share/wallpapers/Next
  sed -i 's/"Id": "AVYX-Aurora"/"Id": "Next"/' /usr/share/wallpapers/Next/metadata.json || true
fi

# The panel layout (top bar + floating dock) is shipped as the look-and-feel package's own layout
# script, so Plasma builds it on the first start of every new user, with no race and no autostart.
if [ -f /usr/share/avyx/layout.js ]; then
  install -D -m 0644 /usr/share/avyx/layout.js \
    /usr/share/plasma/look-and-feel/org.avyx.desktop/contents/layouts/org.kde.plasma.desktop-layout.js
fi

# Login screen: AVYX wallpaper behind the (Wayland) greeter instead of the stock Breeze one.
if [ -d /usr/share/sddm/themes/breeze ] && [ -f /usr/share/wallpapers/AVYX-Aurora/contents/images/1920x1080.jpg ]; then
  printf '[General]\ntype=image\nbackground=/usr/share/wallpapers/AVYX-Aurora/contents/images/1920x1080.jpg\n' \
    > /usr/share/sddm/themes/breeze/theme.conf.user
fi

# Report which window-decoration engines the image really has (shown in the CI log).
find / -xdev \( -iname '*aurorae*' \) -not -path '/proc/*' 2>/dev/null | head -20 || true

# Installer: use AVYX branding and launcher instead of the Debian ones (if Calamares is present).
if [ -d /etc/calamares ]; then
  if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: avyx/' /etc/calamares/settings.conf
    # run the AVYX shellprocess step right after plymouthcfg
    if ! grep -q '^instances:' /etc/calamares/settings.conf; then
      sed -i 's/^sequence:/instances:\n- id: avyx\n  module: shellprocess\n  config: shellprocess_avyx.conf\n- id: avyxdone\n  module: shellprocess\n  config: shellprocess_avyxdone.conf\n\nsequence:/' /etc/calamares/settings.conf
    fi
    sed -i 's/^\( *\)- umount$/\1- umount\n\1- shellprocess@avyxdone/' /etc/calamares/settings.conf
    sed -i 's/^\( *\)- plymouthcfg$/\1- plymouthcfg\n\1- shellprocess@avyx/' /etc/calamares/settings.conf
    # Debian's sequence expects an offline package repository on the install medium and runs
    # `apt-get install grub-*` inside the target. This ISO carries no such repo, and the GRUB
    # binaries (grub-efi-amd64-bin, grub-pc-bin) are already in the image, so Calamares'
    # own `bootloader` step (grub-install) does the job. Drop the steps that need the repo.
    for m in sources-media sources-media-unmount sources-final bootloader-config; do
      sed -i "/^ *- ${m}\$/d" /etc/calamares/settings.conf
    done
  fi
  rm -f /usr/share/applications/install-debian.desktop
  # Any other Debian-branded installer launcher (menu entry or live-config desktop-icon script).
  grep -rlis -e 'Install Debian' /usr/share/applications | xargs -r rm -f
  find /usr/lib/live/config /lib/live/config -maxdepth 1 -iname '*calamares*' -exec rm -f {} + 2>/dev/null || true
  rm -rf /usr/share/calamares/branding/debian /etc/calamares/branding/debian
fi

# Print the final installer sequence so the CI log shows what shipped.
[ -f /etc/calamares/settings.conf ] && grep -vE '^\s*#|^\s*$' /etc/calamares/settings.conf || true
