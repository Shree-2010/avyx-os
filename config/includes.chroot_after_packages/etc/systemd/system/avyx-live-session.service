[Unit]
Description=AVYX live session setup (autologin, installer shortcut)
ConditionKernelCommandLine=boot=live
After=live-config.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/avyx/live-session.sh

[Install]
WantedBy=multi-user.target
